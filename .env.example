# Firebase Configuration (Example/Placeholder)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ⚠️ AI API Keys — SERVER-SIDE ONLY (NOT VITE_ prefix — do NOT expose to frontend)
# Add these to Vercel Environment Variables dashboard, NOT here in a committed .env file
# GROQ_API_KEY=your_groq_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# HiveMQ Dedicated Cloud Broker (IOT365 Cluster) — Demo fallback only
# Note: .env is gitignored and only used as a local/sandbox demo fallback.
# Production devices should use EMQX Auto-Provisioning or per-user Private Broker settings.
VITE_MQTT_BROKER_URL=wss://your-cluster-id.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=your_hivemq_cluster_username
VITE_MQTT_PASSWORD=your_hivemq_cluster_password

# EMQX Cloud Serverless Auto-Provisioning — SERVER-SIDE ONLY (Vercel Environment Variables)
# DO NOT prefix EMQX_APP_ID or EMQX_APP_SECRET with VITE_!
# EMQX_API_URL=https://your-deployment-id.ala.eu-central-1.emqxsl.com:8443/api/v5
# EMQX_BROKER_HOST=your-deployment-id.ala.eu-central-1.emqxsl.com
# EMQX_APP_ID=your_emqx_app_id
# EMQX_APP_SECRET=your_emqx_app_secret
# FIREBASE_API_KEY=your_firebase_api_key_here
