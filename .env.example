# Firebase Configuration (Example/Placeholder)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ⚠️ AI API Keys — SERVER-SIDE ONLY (NOT VITE_ prefix — do NOT expose to frontend)
# Add these to Vercel Environment Variables dashboard, NOT here in a committed .env file
# GROQ_API_KEY=your_groq_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# MQTT Broker (optional — defaults to public HiveMQ if not set)
# For a private broker, set this variable:
# VITE_MQTT_BROKER_URL=wss://your-private-broker.example.com:8884/mqtt
