rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: التحقق الصارم من صلاحيات المسؤول
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }
    
    // ─────────────────────────────────────────────────────────────
    // 1. Users collection (حسابات المستخدمين والملفات الشخصية)
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == 'user')
      );
      allow update: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data.diff(resource.data).affectedKeys()))
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // Subcollections (الأجهزة، الإعدادات، المفاتيح الخاصة بالمستخدم)
      match /{allChildren=**} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 2. User general settings (إعدادات الخصوصية والرسائل)
    // ─────────────────────────────────────────────────────────────
    match /user_settings/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Projects collection (مستودع المشاريع والمخططات في المجتمع)
    // ─────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      // القراءة: عامة للمشاريع العامة، وخاصة لصاحب المشروع أو للأدمن فقط
      allow read: if isAdmin() 
                  || resource == null 
                  || resource.data.visibility == 'public' 
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      
      // الإنشاء: للمسجلين مع إلزام مطابقة ownerId
      allow create: if request.auth != null && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      
      // التعديل:
      // - صاحب المشروع أو الأدمن يعدّل المشروع بالكامل
      // - أي مستخدم مسجل يمكنه التفاعل مع metrics (المشاهدات، الإعجابات، النسخ) للمشاريع العامة
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.ownerId == request.auth.uid || 
          (
            resource.data.visibility == 'public' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metrics'])
          )
        )
      );

      // الحذف: فقط لصاحب المشروع أو الأدمن
      allow delete: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);

      // أسئلة واستفسارات المشروع (Public Q&A)
      match /public_qa/{qaId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (
          request.auth != null && (
            resource.data.authorId == request.auth.uid || 
            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
          )
        );
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Discussions & Forum (منتدى النقاشات والأسئلة التقنية)
    // ─────────────────────────────────────────────────────────────
    match /discussions/{discussionId} {
      // القراءة: عامة للجميع
      allow read: if true;
      
      // الإنشاء: للمستخدم المسجل مع مطابقة authorId
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      
      // التعديل: لصاحب السؤال أو للأدمن، أو لأي مستخدم مسجل للتصويت (upvotes) وتحديث عدد الإجابات
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes', 'answersCount', 'isAnswered'])
        )
      );
      
      // الحذف: فقط لصاحب السؤال أو الأدمن
      allow delete: if isAdmin() || (request.auth != null && resource.data.authorId == request.auth.uid);

      // الأجوبة والردود على النقاش (Answers subcollection)
      match /answers/{answerId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if isAdmin() || (
          request.auth != null && (
            resource.data.authorId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'isAccepted'])
          )
        );
        allow delete: if isAdmin() || (request.auth != null && resource.data.authorId == request.auth.uid);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Direct Messaging (نظام المراسلة الفورية بين المطورين)
    // ─────────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      // التعديل: المشارك يقدر يعدّل حقول غير participants (مثل آخر رسالة، حالة القراءة، التوقيت)
      allow update: if isAdmin() || (
        request.auth != null && 
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants
      );
      allow delete: if isAdmin();

      // رسائل المحادثة (Messages subcollection)
      match /messages/{messageId} {
        allow read: if isAdmin() || (
          request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if request.auth != null && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 6. Notifications & Saved Projects (الإشعارات والمشاريع المحفوظة)
    // ─────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null;
    }

    match /saved_projects/{saveId} {
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // 7. Safety, Moderation & System Config
    // ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
