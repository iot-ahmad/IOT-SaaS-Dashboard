rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: التحقق الصارم من صلاحيات المسؤول
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }
    
    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == 'user')
      );
      allow update: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data.diff(resource.data).affectedKeys()))
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // Subcollections (settings, devices, automations, etc.)
      match /{allChildren=**} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // 2. User general settings (e.g. messaging privacy, blocked users)
    match /user_settings/{userId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // 3. Projects collection
    match /projects/{projectId} {
      // القراءة: عامة للمشاريع العامة، وخاصة لصاحب المشروع أو للأدمن فقط
      allow read: if isAdmin() 
                  || resource == null 
                  || resource.data.visibility == 'public' 
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      
      // الإنشاء: للمسجلين مع إلزام مطابقة ownerId
      allow create: if request.auth != null && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      
      // التعديل: فصل كامل عن الحذف
      // - صاحب المشروع أو الأدمن يعدّل المشروع
      // - المستخدمين الآخرين يمكنهم فقط تعديل metrics بشرط أن يكون المشروع عاماً (Public)
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.ownerId == request.auth.uid || 
          (
            resource.data.visibility == 'public' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metrics'])
          )
        )
      );

      // الحذف: فقط لصاحب المشروع أو الأدمن
      allow delete: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);

      // Public Q&A subcollection for projects
      match /public_qa/{qaId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (
          request.auth != null && (
            resource.data.authorId == request.auth.uid || 
            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
          )
        );
      }
    }

    // 4. Direct Messaging
    match /conversations/{conversationId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAdmin() || (
          request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if request.auth != null && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // 5. Reports collection (safety & moderation)
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // 6. System Configurations & Global Announcements
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
